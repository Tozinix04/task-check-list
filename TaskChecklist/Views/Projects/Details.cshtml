@model TaskChecklist.ViewModels.ProjectDetailsViewModel

@{
    ViewData["Title"] = "Project Details";
}

<h1>@Model.Project.Name</h1>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Description</h5>
        <p class="card-text">@Model.Project.Description</p>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Progress</h5>
        <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-2">
            <span>
                Total tasks: <strong>@Model.Progress.TotalTasks</strong>
                <span class="mx-2 text-muted">&middot;</span>
                Completed: <strong>@Model.Progress.CompletedTasks</strong>
            </span>
            <span class="fs-5"><strong>@Model.Progress.PercentCompleted%</strong> completed</span>
        </div>
        <div class="progress" role="progressbar" aria-label="Tasks completed"
             aria-valuenow="@Model.Progress.PercentCompleted" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar bg-success" style="width: @Model.Progress.PercentCompleted%"></div>
        </div>

        <div class="mt-3">
            @if (Model.Progress.TotalChecklistItems > 0)
            {
                <div class="small text-muted mb-1">
                    Checklist items: @Model.Progress.DoneChecklistItems / @Model.Progress.TotalChecklistItems done (@Model.Progress.ChecklistPercentDone%)
                </div>
                <div class="progress" role="progressbar" aria-label="Checklist items done" style="height: 0.5rem"
                     aria-valuenow="@Model.Progress.ChecklistPercentDone" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar bg-info" style="width: @Model.Progress.ChecklistPercentDone%"></div>
                </div>
            }
            else
            {
                <div class="small text-muted">No checklist items yet.</div>
            }
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Tasks</h3>
    <a asp-controller="Tasks" asp-action="Create" asp-route-projectId="@Model.Project.Id" class="btn btn-success">Add Task</a>
</div>

@{
    var filters = new[]
    {
        (Filter: TaskStatusFilter.All, Label: "All"),
        (Filter: TaskStatusFilter.Completed, Label: "Completed"),
        (Filter: TaskStatusFilter.Pending, Label: "Not completed")
    };
}
<nav class="btn-group mb-3" role="group" aria-label="Filter tasks by status">
    @foreach (var option in filters)
    {
        var isActive = option.Filter == Model.StatusFilter;
        <a asp-action="Details" asp-route-id="@Model.Project.Id"
           asp-route-status="@(option.Filter == TaskStatusFilter.All ? null : option.Filter.ToString().ToLowerInvariant())"
           class="btn btn-outline-primary @(isActive ? "active" : null)"
           aria-current="@(isActive ? "page" : null)">@option.Label</a>
    }
</nav>

@if (Model.Tasks.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Due Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in Model.Tasks)
            {
                <tr>
                    <td>@task.Title</td>
                    <td>@(task.DueDate?.ToString("yyyy-MM-dd") ?? "No due date")</td>
                    <td>
                        @if (task.IsCompleted)
                        {
                            <span class="badge bg-success">Completed</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-controller="Tasks" asp-action="Edit" asp-route-id="@task.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-controller="Tasks" asp-action="Delete" asp-route-id="@task.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        @Model.EmptyTasksMessage
    </div>
}

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.Project.Id" class="btn btn-warning">Edit Project</a>
    <a asp-action="Index" class="btn btn-secondary">Back to Projects</a>
</div>
