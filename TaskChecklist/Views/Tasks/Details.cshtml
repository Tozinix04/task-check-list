@model TaskChecklist.ViewModels.TaskDetailsViewModel

@{
    ViewData["Title"] = "Task Details";
}

<h1>@Model.Task.Title</h1>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-header">
        <strong>Project:</strong>
        <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Task.ProjectId">@Model.Task.Project.Name</a>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Task.Description) ? "No description" : Model.Task.Description)</dd>

            <dt class="col-sm-3">Due Date</dt>
            <dd class="col-sm-9">@(Model.Task.DueDate?.ToString("yyyy-MM-dd") ?? "No due date")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.Task.IsCompleted)
                {
                    <span class="badge bg-success">Completed</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Pending</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Checklist</h2>
        <span class="badge bg-secondary">@Model.DoneChecklistItemsCount / @Model.ChecklistItems.Count done</span>
    </div>
    <div class="card-body">
        @if (Model.ChecklistItems.Any())
        {
            <ul class="list-group">
                @foreach (var item in Model.ChecklistItems)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @if (item.IsDone)
                        {
                            <span class="text-decoration-line-through text-muted">@item.Title</span>
                            <span class="badge bg-success">Done</span>
                        }
                        else
                        {
                            <span>@item.Title</span>
                            <span class="badge bg-light text-dark border">To do</span>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="alert alert-info mb-0">
                No checklist items yet. Add the first one below.
            </div>
        }
    </div>
    <div class="card-footer">
        <form asp-action="AddChecklistItem" asp-route-id="@Model.Task.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-2 align-items-start">
                <div class="col-md">
                    <label asp-for="NewChecklistItem.Title" class="visually-hidden"></label>
                    <input asp-for="NewChecklistItem.Title" class="form-control" placeholder="New checklist item" />
                    <span asp-validation-for="NewChecklistItem.Title" class="text-danger"></span>
                </div>
                <div class="col-md-auto pt-md-2">
                    <div class="form-check">
                        <input asp-for="NewChecklistItem.IsDone" class="form-check-input" />
                        <label asp-for="NewChecklistItem.IsDone" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-md-auto">
                    <button type="submit" class="btn btn-primary">Add item</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.Task.Id" class="btn btn-warning">Edit</a>
    <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Task.ProjectId" class="btn btn-secondary">Back to Project</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
